{
  "name": "hplcsimulator-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-05",
  "keep_vars": true,
  "vars": {
    "MAILGUN_DOMAIN": "mg.hplcsimulator.org",
    "MAILGUN_REGION": "US",
    "CONTACT_FROM": "HPLC Simulator <contact@mg.hplcsimulator.org>"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
